package main

import "base:intrinsics"
import "core:fmt"
import "core:strconv"
import "core:strings"

Emitter :: struct {
	b:      strings.Builder,
	ir:     ^IR,
	uses_c: bool,
	err:    string,
}

ODIN_KEYWORDS :: [?]string{
	"asm", "auto_cast", "bit_field", "bit_set", "break", "case", "cast", "context", "continue", "defer",
	"distinct", "do", "dynamic", "else", "enum", "fallthrough", "for", "foreign", "if", "import", "in",
	"map", "matrix", "not_in", "or_break", "or_continue", "or_else", "or_return", "package", "proc",
	"return", "struct", "switch", "transmute", "typeid", "union", "using", "when", "where",
}

C_PRIMITIVES :: [?][2]string{
	{"void", "void"},
	{"char", "u8"},
	{"int", "c.int"},
	{"int8_t", "i8"},
	{"int16_t", "i16"},
	{"int32_t", "i32"},
	{"int64_t", "i64"},
	{"uint8_t", "u8"},
	{"uint16_t", "u16"},
	{"uint32_t", "u32"},
	{"uint64_t", "u64"},
	{"size_t", "uint"},
	{"float", "f32"},
	{"double", "f64"},
}

// The shared library carries its own dependencies. The static one needs the C++ runtime and, on macOS,
// the frameworks of the Metal backend. On Linux, Dawn loads Vulkan at runtime with dlopen; on Windows,
// D3D12 and DXGI with LoadLibrary, and the objects name the C++ runtime (the static one, /MT) themselves.
// DAWN_SHARED, DAWN_LIB and DAWN_STATIC_CXX are in wgpu.odin.
FOREIGN_IMPORT :: `when DAWN_SHARED {
	foreign import lib {
		DAWN_LIB,
	}
} else when ODIN_OS == .Linux {
	when DAWN_STATIC_CXX {
		foreign import lib {
			DAWN_LIB,
			"system:libstdc++.a",
			"system:m",
			"system:dl",
			"system:pthread",
		}
	} else {
		foreign import lib {
			DAWN_LIB,
			"system:stdc++",
			"system:m",
			"system:dl",
			"system:pthread",
		}
	}
} else when ODIN_OS == .Darwin {
	foreign import lib {
		DAWN_LIB,
		"system:c++",
		"system:Cocoa.framework",
		"system:CoreFoundation.framework",
		"system:Foundation.framework",
		"system:IOKit.framework",
		"system:IOSurface.framework",
		"system:Metal.framework",
		"system:QuartzCore.framework",
	}
} else when ODIN_OS == .Windows {
	foreign import lib {
		DAWN_LIB,
		"system:user32.lib",
		"system:onecore_apiset.lib",
		"system:dxguid.lib",
	}
}

`

// Values of the header's `#define WGPU_X (VALUE)` constants.
C_CONSTANT_VALUES :: [?][2]string{
	{"UINT32_MAX", "max(u32)"},
	{"UINT64_MAX", "max(u64)"},
	{"SIZE_MAX", "max(uint)"},
	{"NAN", "f32(0h7FC0_0000)"},
}

// Functions emitted as `Raw<Name>`, keeping their C symbol, because wgpu.odin wraps them with Odin-friendly
// signatures (slices, multiple return values). The same set as vendor:wgpu, so code calling either the
// wrappers or the Raw procs compiles against both.
RAW_FUNCTIONS :: [?]string{
	"GetInstanceLimits",
	"AdapterGetFeatures",
	"AdapterGetInfo",
	"AdapterGetLimits",
	"BufferGetConstMappedRange",
	"BufferGetMappedRange",
	"ComputePassEncoderSetBindGroup",
	"DeviceGetAdapterInfo",
	"DeviceGetFeatures",
	"DeviceGetLimits",
	"QueueSubmit",
	"RenderBundleEncoderSetBindGroup",
	"RenderPassEncoderExecuteBundles",
	"RenderPassEncoderSetBindGroup",
	"SurfaceGetCapabilities",
	"SurfaceGetCurrentTexture",
}

// Generates the Odin bindings for a Dawn `webgpu.h`. `source` and `version` only go into the file header.
generate :: proc(header_src, source, version: string) -> (out: string, err: string) {
	// A header checked out with CRLF line endings (Git for Windows' core.autocrlf) would hide the
	// backslashes ending the continuation lines of multi-line macros.
	src, _ := strings.remove_all(header_src, "\r")
	ir, parse_err := parse(src)
	if parse_err != "" {
		return "", parse_err
	}
	e := Emitter{ir = ir}
	emit_body(&e)
	if e.err != "" {
		return "", e.err
	}

	b := strings.builder_make()
	fmt.sbprintf(&b, "// Code generated by tools/gen from %s. DO NOT EDIT.\n", source)
	if version != "" {
		fmt.sbprintf(&b, "// Dawn version: %s\n", version)
	}
	strings.write_string(&b, "package wgpu\n\n")
	if e.uses_c {
		strings.write_string(&b, "import \"core:c\"\n\n")
	}
	strings.write_string(&b, strings.to_string(e.b))
	return strings.to_string(b), ""
}

// Extracts `major.minor` from Dawn's `dawn_version.h`, or "" when not found.
parse_dawn_version :: proc(src: string) -> string {
	major, minor: string
	for line in strings.split_lines(src) {
		fields := strings.fields(line)
		if len(fields) == 3 && fields[0] == "#define" {
			switch fields[1] {
			case "DAWN_MAJOR_VERSION":
				major = fields[2]
			case "DAWN_MINOR_VERSION":
				minor = fields[2]
			}
		}
	}
	if major == "" || minor == "" {
		return ""
	}
	return fmt.aprintf("%s.%s", major, minor)
}

@(private = "file")
error :: proc(e: ^Emitter, format: string, args: ..any) {
	if e.err == "" {
		e.err = fmt.aprintf(format, ..args)
	}
}

escape_keyword :: proc(name: string) -> string {
	for k in ODIN_KEYWORDS {
		if name == k {
			return fmt.aprintf("%s_", name)
		}
	}
	return name
}

strip_type_prefix :: proc(name: string) -> string {
	return strings.trim_prefix(name, "WGPU")
}

enum_member_name :: proc(name: string) -> string {
	if len(name) > 0 && is_digit(name[0]) {
		return fmt.aprintf("_%s", name)
	}
	return escape_keyword(name)
}

@(private = "file")
skipped_type :: proc(name: string) -> bool {
	// StringView is mapped to an Odin string instead.
	return strings.contains(name, "INTERNAL") || name == "WGPUStringView"
}

@(private = "file")
find_struct :: proc(ir: ^IR, name: string) -> ^Struct {
	for &s in ir.structs {
		if s.name == name {
			return &s
		}
	}
	return nil
}

@(private = "file")
find_enum :: proc(list: []Enum, name: string) -> ^Enum {
	for &e in list {
		if e.name == name {
			return &e
		}
	}
	return nil
}

@(private = "file")
base_type_name :: proc(e: ^Emitter, name: string) -> string {
	for prim in C_PRIMITIVES {
		if prim[0] == name {
			if prim[1] == "c.int" {
				e.uses_c = true
			}
			return prim[1]
		}
	}
	switch e.ir.kinds[name] {
	case .None:
		error(e, "unknown C type '%s'", name)
		return name
	case .Bitflag:
		return fmt.aprintf("%sFlags", strip_type_prefix(name))
	case .Alias, .Handle, .Enum, .Callback, .Struct:
	}
	return strip_type_prefix(name)
}

// `multi` turns the outermost pointer into a multi-pointer, for pointer + count pairs.
@(private = "file")
odin_type :: proc(e: ^Emitter, t: C_Type, multi := false) -> string {
	if t.pointers == 0 {
		if t.name == "WGPUStringView" {
			return "StringView"
		}
		return base_type_name(e, t.name)
	}
	pointers := t.pointers
	base: string
	switch t.name {
	case "void":
		base = "rawptr"
		pointers -= 1
	case "char":
		base = "cstring"
		pointers -= 1
	case:
		base = base_type_name(e, t.name)
	}
	if pointers == 0 {
		return base
	}
	b := strings.builder_make()
	for _ in 0 ..< pointers - 1 {
		strings.write_string(&b, "^")
	}
	strings.write_string(&b, "[^]" if multi else "^")
	strings.write_string(&b, base)
	return strings.to_string(b)
}

// Whether `params[i]` is the pointer of a `xCount`/`xSize` + pointer pair.
@(private = "file")
is_counted_pointer :: proc(params: []Param, i: int) -> bool {
	if i == 0 {
		return false
	}
	prev, cur := params[i - 1], params[i]
	count_type := prev.type.name == "size_t" || prev.type.name == "uint32_t" || prev.type.name == "uint64_t"
	// `entryCount` + `entries`, but `codeSize` + `code` only: `dataSize` + `dataLayout` is not a pair.
	count_name := strings.has_suffix(prev.name, "Count") || prev.name == fmt.tprintf("%sSize", cur.name)
	if prev.type.pointers != 0 || !count_type || !count_name || cur.type.pointers == 0 {
		return false
	}
	switch cur.type.name {
	case "void":
		return false
	case "char":
		return cur.type.pointers >= 2
	}
	return true
}

@(private = "file")
write_params :: proc(e: ^Emitter, params: []Param, defaults: bool) {
	// Trailing nullable pointers and handles get a `nil` default.
	first_default := len(params)
	if defaults {
		for i := len(params) - 1; i >= 0; i -= 1 {
			p := params[i]
			nil_able := p.type.pointers > 0 || e.ir.kinds[p.type.name] == .Handle
			if !p.type.nullable || !nil_able {
				break
			}
			first_default = i
		}
	}
	for p, i in params {
		if i > 0 {
			strings.write_string(&e.b, ", ")
		}
		if p.type.nullable {
			strings.write_string(&e.b, "/* NULLABLE */ ")
		}
		fmt.sbprintf(&e.b, "%s: %s", escape_keyword(p.name), odin_type(e, p.type, is_counted_pointer(params, i)))
		if i >= first_default {
			strings.write_string(&e.b, " = nil")
		}
	}
}

@(private = "file")
write_signature :: proc(e: ^Emitter, f: Proc, defaults: bool) {
	strings.write_string(&e.b, "(")
	write_params(e, f.params[:], defaults)
	strings.write_string(&e.b, ")")
	if !(f.ret.name == "void" && f.ret.pointers == 0) {
		fmt.sbprintf(&e.b, " -> %s", odin_type(e, f.ret))
	}
}

@(private = "file")
constant_value :: proc(e: ^Emitter, c: Constant) -> (string, bool) {
	tokens := make([dynamic]Token)
	for t in c.value {
		if t.text != "(" && t.text != ")" {
			append(&tokens, t)
		}
	}
	// `UINT32_C(1)` lexes as `UINT32_C 1` once parentheses are dropped.
	if len(tokens) == 2 && strings.has_suffix(tokens[0].text, "_C") && tokens[1].kind == .Number {
		return tokens[1].text, true
	}
	if len(tokens) == 1 {
		for v in C_CONSTANT_VALUES {
			if tokens[0].text == v[0] {
				return v[1], true
			}
		}
		if tokens[0].kind == .Number {
			return tokens[0].text, true
		}
	}
	error(e, "unsupported value for constant %s", c.name)
	return "", false
}

@(private = "file")
emit_constants :: proc(e: ^Emitter) {
	for c in e.ir.constants {
		// Odin has `true` and `false`.
		if c.name == "WGPU_TRUE" || c.name == "WGPU_FALSE" {
			continue
		}
		name := strings.trim_prefix(c.name, "WGPU_")
		if c.name == "WGPU_STRLEN" {
			// StringView is an Odin string, whose length is an int.
			strings.write_string(&e.b, "STRLEN :: transmute(int)(max(uint))\n")
			continue
		}
		value := constant_value(e, c) or_continue
		fmt.sbprintf(&e.b, "%s :: %s\n", name, value)
	}
	strings.write_string(&e.b, "\n")
}

@(private = "file")
emit_types :: proc(e: ^Emitter) {
	for a in e.ir.aliases {
		type := "b32" if a.name == "WGPUBool" else base_type_name(e, a.type)
		fmt.sbprintf(&e.b, "%s :: %s\n", strip_type_prefix(a.name), type)
	}
	strings.write_string(&e.b, "\n// StringView has the layout of an Odin string: {data, length}.\nStringView :: string\n\n")

	for h in e.ir.handles {
		fmt.sbprintf(&e.b, "%s :: distinct rawptr\n", strip_type_prefix(h))
	}
	strings.write_string(&e.b, "\n")

	for en in e.ir.enums {
		fmt.sbprintf(&e.b, "%s :: enum i32 {{\n", strip_type_prefix(en.name))
		for entry in en.entries {
			fmt.sbprintf(&e.b, "\t%s = %s,\n", enum_member_name(entry.name), entry.text)
		}
		strings.write_string(&e.b, "}\n\n")
	}

	for flags in e.ir.bitflags {
		name := strip_type_prefix(flags.name)
		fmt.sbprintf(&e.b, "%s :: enum i32 {{\n", name)
		for entry in flags.entries {
			if intrinsics.count_ones(entry.value) == 1 {
				fmt.sbprintf(&e.b, "\t%s = %d,\n", enum_member_name(entry.name), intrinsics.count_trailing_zeros(entry.value))
			}
		}
		fmt.sbprintf(&e.b, "}}\n%sFlags :: bit_set[%s; Flags]\n", name, name)
		for entry in flags.entries {
			if intrinsics.count_ones(entry.value) > 1 {
				fmt.sbprintf(&e.b, "%sFlags_%s :: %sFlags{{", name, entry.name, name)
				write_flag_members(e, flags, entry.value)
				strings.write_string(&e.b, "}\n")
			}
		}
		strings.write_string(&e.b, "\n")
	}

	for cb in e.ir.callbacks {
		fmt.sbprintf(&e.b, "%s :: #type proc \"c\" ", strip_type_prefix(cb.name))
		write_signature(e, cb, false)
		strings.write_string(&e.b, "\n")
	}
	strings.write_string(&e.b, "\n")

	for s in e.ir.structs {
		if skipped_type(s.name) {
			continue
		}
		fmt.sbprintf(&e.b, "%s :: struct {{\n", strip_type_prefix(s.name))
		for f, i in s.fields {
			strings.write_string(&e.b, "\t")
			if f.type.nullable {
				strings.write_string(&e.b, "/* NULLABLE */ ")
			}
			if f.name == "chain" && f.type.name == "WGPUChainedStruct" && f.type.pointers == 0 {
				strings.write_string(&e.b, "using ")
			}
			fmt.sbprintf(&e.b, "%s: %s,\n", escape_keyword(f.name), odin_type(e, f.type, is_counted_pointer(s.fields[:], i)))
		}
		strings.write_string(&e.b, "}\n\n")
	}
}

// Writes `.A, .B` for the single-bit members whose bits are set in `value`.
@(private = "file")
write_flag_members :: proc(e: ^Emitter, flags: Enum, value: u64) {
	first := true
	for entry in flags.entries {
		if intrinsics.count_ones(entry.value) == 1 && value & entry.value != 0 {
			fmt.sbprintf(&e.b, "%s.%s", "" if first else ", ", enum_member_name(entry.name))
			first = false
		}
	}
}

@(private = "file")
init_name :: proc(macro: string) -> string {
	return strings.trim_prefix(macro, "WGPU_")
}

@(private = "file")
find_init :: proc(ir: ^IR, name: string) -> bool {
	for init in ir.inits {
		if init.name == name {
			return true
		}
	}
	return false
}

// The Odin text for one value of an `_INIT` macro. `ok` is false for values equal to Odin's zero value,
// which are left out of the literal.
@(private = "file")
init_value :: proc(e: ^Emitter, expr: Init_Expr, type: C_Type) -> (text: string, ok: bool) {
	if expr.struct_name != "" {
		s := find_struct(e.ir, expr.struct_name)
		if s == nil {
			error(e, "_INIT of unknown struct '%s'", expr.struct_name)
			return "", false
		}
		b := strings.builder_make()
		count := 0
		for f in expr.fields {
			field_type: C_Type
			found := false
			for sf in s.fields {
				if sf.name == f.name {
					field_type, found = sf.type, true
				}
			}
			if !found {
				error(e, "_INIT of %s sets unknown field '%s'", expr.struct_name, f.name)
				return "", false
			}
			value := init_value(e, f.value, field_type) or_continue
			fmt.sbprintf(&b, "%s%s = %s", ", " if count > 0 else "", escape_keyword(f.name), value)
			count += 1
		}
		return fmt.aprintf("{{%s}}", strings.to_string(b)), count > 0
	}

	atom := expr.atom
	switch atom {
	case "NULL", "WGPU_FALSE", "_wgpu_ENUM_ZERO_INIT", "_wgpu_STRUCT_ZERO_INIT", "WGPU_STRING_VIEW_INIT":
		return "", false
	case "WGPU_TRUE":
		return "true", true
	}

	if is_digit(atom[0]) || atom[0] == '.' {
		return number_value(atom)
	}
	if strings.has_prefix(atom, "WGPU_") && strings.has_suffix(atom, "_INIT") {
		if !find_init(e.ir, atom) {
			error(e, "reference to unknown init macro '%s'", atom)
		}
		return init_name(atom), true
	}
	if strings.has_prefix(atom, "WGPU_") {
		return strings.trim_prefix(atom, "WGPU_"), true
	}

	// An enum or flag value: `WGPUType_Member`.
	prefix := fmt.aprintf("%s_", type.name)
	if !strings.has_prefix(atom, prefix) {
		error(e, "init value '%s' does not match field type '%s'", atom, type.name)
		return "", false
	}
	member := atom[len(prefix):]
	if en := find_enum(e.ir.enums[:], type.name); en != nil {
		for entry in en.entries {
			if entry.name == member {
				return fmt.aprintf(".%s", enum_member_name(member)), entry.value != 0
			}
		}
	} else if flags := find_enum(e.ir.bitflags[:], type.name); flags != nil {
		for entry in flags.entries {
			if entry.name == member {
				switch intrinsics.count_ones(entry.value) {
				case 0:
					return "", false
				case 1:
					return fmt.aprintf("{{.%s}}", enum_member_name(member)), true
				case:
					return fmt.aprintf("%sFlags_%s", strip_type_prefix(type.name), member), true
				}
			}
		}
	}
	error(e, "unknown init value '%s'", atom)
	return "", false
}

// C number literal to Odin. `0`, `0.` and `0.f` are zero values and left out.
@(private = "file")
number_value :: proc(text: string) -> (string, bool) {
	if strings.has_prefix(text, "0x") || strings.has_prefix(text, "0X") {
		v, _ := strconv.parse_u64(text)
		return text, v != 0
	}
	t := strings.trim_suffix(text, "f")
	if strings.has_suffix(t, ".") {
		t = fmt.aprintf("%s0", t)
	}
	v, _ := strconv.parse_f64(t)
	return t, v != 0
}

@(private = "file")
emit_inits :: proc(e: ^Emitter) {
	for init in e.ir.inits {
		if init.value.struct_name == "WGPUStringView" || skipped_type(init.value.struct_name) {
			continue
		}
		value, _ := init_value(e, init.value, {})
		fmt.sbprintf(&e.b, "%s :: %s%s\n", init_name(init.name), strip_type_prefix(init.value.struct_name), value)
	}
	strings.write_string(&e.b, "\n")
}

@(private = "file")
is_raw_function :: proc(name: string) -> bool {
	for raw in RAW_FUNCTIONS {
		if name == raw {
			return true
		}
	}
	return false
}

@(private = "file")
emit_functions :: proc(e: ^Emitter) {
	// Imports are file-scoped, so the import goes next to the foreign block. DAWN_LIB is in wgpu.odin.
	strings.write_string(&e.b, FOREIGN_IMPORT)
	strings.write_string(&e.b, "@(default_calling_convention = \"c\", link_prefix = \"wgpu\")\nforeign lib {\n")
	for f in e.ir.functions {
		if !strings.has_prefix(f.name, "wgpu") {
			error(e, "exported function '%s' without the wgpu prefix", f.name)
			continue
		}
		name := f.name[len("wgpu"):]
		if is_raw_function(name) {
			fmt.sbprintf(&e.b, "\t@(link_name = \"%s\")\n\tRaw%s :: proc", f.name, name)
		} else if e.ir.kinds[fmt.aprintf("WGPU%s", name)] != .None {
			// The function has the name of a type, e.g. wgpuSharedFenceExportInfo.
			fmt.sbprintf(&e.b, "\t@(link_name = \"%s\")\n\t%s_ :: proc", f.name, name)
		} else {
			fmt.sbprintf(&e.b, "\t%s :: proc", name)
		}
		write_signature(e, f, true)
		strings.write_string(&e.b, " ---\n")
	}
	strings.write_string(&e.b, "}\n")
}

@(private = "file")
emit_body :: proc(e: ^Emitter) {
	emit_constants(e)
	emit_types(e)
	emit_inits(e)
	emit_functions(e)
}
