Callback :: #type proc "c" (userdata: rawptr)
Proc :: #type proc "c" ()
BufferMapCallback :: #type proc "c" (status: MapAsyncStatus, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
CompilationInfoCallback :: #type proc "c" (status: CompilationInfoRequestStatus, compilationInfo: ^CompilationInfo, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
CreateComputePipelineAsyncCallback :: #type proc "c" (status: CreatePipelineAsyncStatus, pipeline: ComputePipeline, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
CreateRenderPipelineAsyncCallback :: #type proc "c" (status: CreatePipelineAsyncStatus, pipeline: RenderPipeline, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
DawnLoadCacheDataCallback :: #type proc "c" (keySize: uint, key: [^]u8, valueSize: uint, value: [^]u8, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr) -> uint
DawnStoreCacheDataCallback :: #type proc "c" (keySize: uint, key: [^]u8, valueSize: uint, value: [^]u8, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
DeviceLostCallback :: #type proc "c" (device: ^Device, reason: DeviceLostReason, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
DisposeCallback :: #type proc "c" (status: CallbackStatus, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
LoggingCallback :: #type proc "c" (type: LoggingType, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
PopErrorScopeCallback :: #type proc "c" (status: PopErrorScopeStatus, type: ErrorType, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
QueueWorkDoneCallback :: #type proc "c" (status: QueueWorkDoneStatus, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
RequestAdapterCallback :: #type proc "c" (status: RequestAdapterStatus, adapter: Adapter, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
RequestDeviceCallback :: #type proc "c" (status: RequestDeviceStatus, device: Device, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)
UncapturedErrorCallback :: #type proc "c" (device: ^Device, type: ErrorType, message: StringView, /* NULLABLE */ userdata1: rawptr, /* NULLABLE */ userdata2: rawptr)

