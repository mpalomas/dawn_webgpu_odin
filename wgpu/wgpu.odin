// Odin bindings for Dawn's webgpu.h. The declarations are in wgpu_generated.odin, generated by tools/gen.
//
// The package mirrors vendor:wgpu (wgpu-native): same names, same wrappers. The C functions that take a
// pointer + count or an out parameter are generated as `Raw<Name>` and wrapped below with slices and
// multiple return values, as vendor:wgpu does.
package wgpu

import "base:intrinsics"
import "base:runtime"

// Link the shared Dawn library (libwebgpu_dawn.dylib or .so) instead of the static one.
// Enable with -define:DAWN_SHARED=true.
DAWN_SHARED :: #config(DAWN_SHARED, false)

when ODIN_OS == .Linux {
	@(private) OS  :: "linux"
	@(private) EXT :: ".so" when DAWN_SHARED else ".a"
} else when ODIN_OS == .Darwin {
	@(private) OS  :: "macos"
	@(private) EXT :: ".dylib" when DAWN_SHARED else ".a"
} else {
	#panic("dawn_webgpu_odin: only Linux and macOS are supported for now")
}
@(private) ARCH :: "x86_64" when ODIN_ARCH == .amd64 else "arm64" when ODIN_ARCH == .arm64 else #panic("dawn_webgpu_odin: unsupported architecture")

// Path of the Dawn library, relative to this directory. Override with -define:DAWN_LIB=<path>.
DAWN_LIB :: #config(DAWN_LIB, "../lib/" + OS + "-" + ARCH + "/libwebgpu_dawn" + EXT)

// Linux, static library only: link the C++ runtime statically (libstdc++.a), so the program does not
// require a recent libstdc++.so on the machines it runs on. Enable with -define:DAWN_STATIC_CXX=true.
DAWN_STATIC_CXX :: #config(DAWN_STATIC_CXX, false)

when !#exists(DAWN_LIB) {
	#panic("Could not find the Dawn library at '" + DAWN_LIB + "'. Run tools/update_dawn.sh <dawn install dir>, or pass -define:DAWN_LIB=<path>.")
}

// The `foreign import` is in wgpu_generated.odin, since imports are file-scoped.

// Converts a StringView from Dawn to an Odin string. Dawn marks a null-terminated view
// with a length of STRLEN, and an absent one with nil data and STRLEN.
string_from_view :: proc "contextless" (s: StringView) -> string {
	raw := transmute(runtime.Raw_String)s
	if raw.len != STRLEN {
		return s
	}
	if raw.data == nil {
		return ""
	}
	return string(cstring(raw.data))
}

// The "absent" StringView, {nil, STRLEN}. An empty Odin string is a zero-length string instead,
// which Dawn treats differently for optional names such as entry points.
STRING_VIEW_NULL :: proc "contextless" () -> StringView {
	return transmute(StringView)runtime.Raw_String{nil, STRLEN}
}

// Wrappers of Instance

GetInstanceLimits :: proc "c" () -> (limits: InstanceLimits, status: Status) {
	status = RawGetInstanceLimits(&limits)
	return
}

// Wrappers of Adapter

AdapterGetLimits :: proc "c" (adapter: Adapter) -> (limits: Limits, status: Status) {
	status = RawAdapterGetLimits(adapter, &limits)
	return
}

// Free the result with AdapterInfoFreeMembers. To chain extension structs, call RawAdapterGetInfo.
AdapterGetInfo :: proc "c" (adapter: Adapter) -> (info: AdapterInfo, status: Status) {
	status = RawAdapterGetInfo(adapter, &info)
	return
}

// Free the result with SupportedFeaturesFreeMembers.
AdapterGetFeatures :: proc "c" (adapter: Adapter) -> (features: SupportedFeatures) {
	RawAdapterGetFeatures(adapter, &features)
	return
}

// Wrappers of Buffer
//
// The mapped range wrappers return nil when the range cannot be mapped. The argument order of the
// Slice variants follows vendor:wgpu.

BufferGetConstMappedRange :: proc "c" (buffer: Buffer, offset: uint, size: uint) -> []byte {
	data := ([^]byte)(RawBufferGetConstMappedRange(buffer, offset, size))
	return data[:size] if data != nil else nil
}

BufferGetConstMappedRangeTyped :: proc "c" (buffer: Buffer, offset: uint, $T: typeid) -> ^T
	where !intrinsics.type_is_sliceable(T) {

	return (^T)(RawBufferGetConstMappedRange(buffer, offset, size_of(T)))
}

BufferGetConstMappedRangeSlice :: proc "c" (buffer: Buffer, offset: uint, length: uint, $T: typeid) -> []T {
	data := ([^]T)(RawBufferGetConstMappedRange(buffer, offset, size_of(T) * length))
	return data[:length] if data != nil else nil
}

BufferGetMappedRange :: proc "c" (buffer: Buffer, offset: uint, size: uint) -> []byte {
	data := ([^]byte)(RawBufferGetMappedRange(buffer, offset, size))
	return data[:size] if data != nil else nil
}

BufferGetMappedRangeTyped :: proc "c" (buffer: Buffer, offset: uint, $T: typeid) -> ^T
	where !intrinsics.type_is_sliceable(T) {

	return (^T)(RawBufferGetMappedRange(buffer, offset, size_of(T)))
}

BufferGetMappedRangeSlice :: proc "c" (buffer: Buffer, offset: uint, $T: typeid, length: uint) -> []T {
	data := ([^]T)(RawBufferGetMappedRange(buffer, offset, size_of(T) * length))
	return data[:length] if data != nil else nil
}

// Wrappers of ComputePassEncoder

ComputePassEncoderSetBindGroup :: proc "c" (computePassEncoder: ComputePassEncoder, groupIndex: u32, /* NULLABLE */ group: BindGroup, dynamicOffsets: []u32 = nil) {
	RawComputePassEncoderSetBindGroup(computePassEncoder, groupIndex, group, len(dynamicOffsets), raw_data(dynamicOffsets))
}

// Wrappers of Device

DeviceGetLimits :: proc "c" (device: Device) -> (limits: Limits, status: Status) {
	status = RawDeviceGetLimits(device, &limits)
	return
}

// Free the result with AdapterInfoFreeMembers.
DeviceGetAdapterInfo :: proc "c" (device: Device) -> (info: AdapterInfo, status: Status) {
	status = RawDeviceGetAdapterInfo(device, &info)
	return
}

// Free the result with SupportedFeaturesFreeMembers.
DeviceGetFeatures :: proc "c" (device: Device) -> (features: SupportedFeatures) {
	RawDeviceGetFeatures(device, &features)
	return
}

BufferWithDataDescriptor :: struct {
	/* NULLABLE */ label: StringView,
	usage: BufferUsageFlags,
}

// Creates a buffer holding `data`, mapped at creation. The size is rounded up to a multiple of 4, as
// mappedAtCreation requires.
DeviceCreateBufferWithDataSlice :: proc "c" (device: Device, descriptor: ^BufferWithDataDescriptor, data: []$T) -> (buf: Buffer) {
	size := uint(size_of(T) * len(data))
	buf = DeviceCreateBuffer(device, &{
		label            = descriptor.label,
		usage            = descriptor.usage,
		size             = u64((size + 3) &~ 3),
		mappedAtCreation = true,
	})
	if mapping := BufferGetMappedRangeSlice(buf, 0, T, uint(len(data))); mapping != nil {
		copy(mapping, data)
	}
	BufferUnmap(buf)
	return
}

DeviceCreateBufferWithDataTyped :: proc "c" (device: Device, descriptor: ^BufferWithDataDescriptor, data: $T) -> (buf: Buffer)
	where !intrinsics.type_is_sliceable(T) {

	buf = DeviceCreateBuffer(device, &{
		label            = descriptor.label,
		usage            = descriptor.usage,
		size             = u64((size_of(T) + 3) &~ 3),
		mappedAtCreation = true,
	})
	if mapping := BufferGetMappedRangeTyped(buf, 0, T); mapping != nil {
		mapping^ = data
	}
	BufferUnmap(buf)
	return
}

DeviceCreateBufferWithData :: proc {
	DeviceCreateBufferWithDataSlice,
	DeviceCreateBufferWithDataTyped,
}

// Wrappers of Queue

QueueSubmit :: proc "c" (queue: Queue, commands: []CommandBuffer) {
	RawQueueSubmit(queue, len(commands), raw_data(commands))
}

// Wrappers of RenderBundleEncoder

RenderBundleEncoderSetBindGroup :: proc "c" (renderBundleEncoder: RenderBundleEncoder, groupIndex: u32, /* NULLABLE */ group: BindGroup, dynamicOffsets: []u32 = nil) {
	RawRenderBundleEncoderSetBindGroup(renderBundleEncoder, groupIndex, group, len(dynamicOffsets), raw_data(dynamicOffsets))
}

// Wrappers of RenderPassEncoder

RenderPassEncoderExecuteBundles :: proc "c" (renderPassEncoder: RenderPassEncoder, bundles: []RenderBundle) {
	RawRenderPassEncoderExecuteBundles(renderPassEncoder, len(bundles), raw_data(bundles))
}

RenderPassEncoderSetBindGroup :: proc "c" (renderPassEncoder: RenderPassEncoder, groupIndex: u32, /* NULLABLE */ group: BindGroup, dynamicOffsets: []u32 = nil) {
	RawRenderPassEncoderSetBindGroup(renderPassEncoder, groupIndex, group, len(dynamicOffsets), raw_data(dynamicOffsets))
}

// Wrappers of Surface

// Free the result with SurfaceCapabilitiesFreeMembers.
SurfaceGetCapabilities :: proc "c" (surface: Surface, adapter: Adapter) -> (capabilities: SurfaceCapabilities, status: Status) {
	status = RawSurfaceGetCapabilities(surface, adapter, &capabilities)
	return
}

SurfaceGetCurrentTexture :: proc "c" (surface: Surface) -> (surface_texture: SurfaceTexture) {
	RawSurfaceGetCurrentTexture(surface, &surface_texture)
	return
}
